# =====================================================================
# STAMBHA ENGINEERING SOLUTIONS — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and supply email provider credentials.
# Note: NEVER commit real secret keys into version control.

# Recipient Email for Client Project Enquiries
ENQUIRY_RECIPIENT_EMAIL="contact@stambha.works"

# --- OPTION A: RESEND API (Recommended for modern serverless hosting) ---
RESEND_API_KEY=""

# --- OPTION B: SMTP CREDENTIALS (Alternative for standard mail server) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Stambha Engineering <noreply@stambha.works>"

# --- FRONTEND CONFIGURATION ---
# Official WhatsApp business number format: Country code + 10 digits
VITE_WHATSAPP_NUMBER="919967792083"
